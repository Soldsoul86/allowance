    "agentic-payments",
    "ai-agents",
    "spend-policy",
    "budget",
    "idempotency",
    "double-spend",
    "stablecoin",
    "payments"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/Soldsoul86/allowance/tree/main/packages/x402#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soldsoul86/allowance.git",
    "directory": "packages/x402"
  },
  "bugs": {
    "url": "https://github.com/Soldsoul86/allowance/issues"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/src/index.js",
