{
  "name": "@allowance/journal",
  "version": "0.1.0",
  "description": "Orb Event Journal \u2014 append-only, hash-chained, HLC-ordered history.",
  "keywords": [
    "event-sourcing",
    "append-only",
    "hash-chain",
    "audit-log",
    "hlc",
    "replay",
    "local-first"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/Soldsoul86/allowance/tree/main/packages/journal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soldsoul86/allowance.git",
    "directory": "packages/journal"
  },
  "bugs": {
    "url": "https://github.com/Soldsoul86/allowance/issues"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "DESIGN.md",
    "API.md",
    "TESTS.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "npm run build && node --test --test-reporter=spec \"dist/tests/**/*.test.js\""
  }
}
