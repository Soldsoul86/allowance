{
  "name": "@spendcap/anthropic",
  "version": "0.1.0",
  "description": "The Anthropic SDK behind a spend guard: policy decides, budget reserves, ledger settles at real usage.",
  "keywords": [
    "anthropic",
    "claude",
    "ai-agents",
    "agentic-payments",
    "spend-policy",
    "budget",
    "token-budget",
    "rate-limit"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/Soldsoul86/allowance/tree/main/packages/anthropic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soldsoul86/allowance.git",
    "directory": "packages/anthropic"
  },
  "bugs": {
    "url": "https://github.com/Soldsoul86/allowance/issues"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@spendcap/policy": "0.1.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.50.0"
  }
